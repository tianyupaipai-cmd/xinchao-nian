# Identity used only in optional model prompts and notifications.
AGENT_NAME=心潮
NOTIFICATION_RECIPIENT=用户

# Safe startup defaults.
SHADOW_MODE=true
PORT=18110
SERVICE_TOKEN=replace-with-a-random-secret
STATE_PATH=/app/state/state.json
TRANSITION_JOURNAL_PATH=/app/state/transitions.jsonl
SETTLE_INTERVAL_MINUTES=15
SLEEP_AFTER_MINUTES=90

# Optional OpenAI-compatible model. Disabled by default.
MODEL_ENABLED=false
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_API_KEY=
MODEL_NAME=local-model
MODEL_TIMEOUT_MS=30000
MODEL_MAX_INPUT_CHARS=10000
MODEL_MAX_OUTPUT_TOKENS=650
DREAM_PUSH_PROMPT_PATH=/app/configs/dream_push_prompt.md
DREAM_MIN_INTERVAL_HOURS=6
DREAM_MAX_PER_DAY=4

# Optional authenticated Ombre-compatible Streamable HTTP Memory MCP.
# Disabled by default. If any OMBRE_* integration flag below is true, both
# OMBRE_MCP_URL and OMBRE_MCP_TOKEN are required. Keep the Bearer token only in
# this server-side .env; do not use a Dashboard password or expose it to a UI.
OMBRE_MCP_URL=
OMBRE_MCP_TOKEN=
# 这里只能填心潮服务端能访问的 OB MCP 地址。不要填 xinchaomind.uk，
# 也不要把这个地址交给公开网页或当作心潮 MCP 连接器地址。
# ⚠️ 接了 OB 一定要把 OMBRE_READ_ENABLED 设成 true，否则网页端（xinchaomind.uk）
# 会一直显示"未接入 OB / 记忆星图不可用"，跟 OB 是否真的部署成功无关。
# 联合部署（compose）默认已经帮你开好；单独跑心潮容器、又想在网页看 OB 的，务必设 true。
OMBRE_READ_ENABLED=false
OMBRE_WRITE_ENABLED=false
OMBRE_BREATH_MAX_RESULTS=3
OMBRE_BREATH_MAX_TOKENS=800

# Short-lived Context Envelope. Stable identity/core instructions remain the
# client's responsibility and are never replaced by this envelope.
CONTEXT_ENVELOPE_ENABLED=true
CONTEXT_OMBRE_ENABLED=false
CONTEXT_DEFAULT_MAX_TOKENS=2200
CONTEXT_OMBRE_MAX_TOKENS=1600
CONTEXT_TTL_MINUTES=15
CONTEXT_HANDOFF_ONCE_HOURS=12

# Remote Streamable HTTP MCP. Leave disabled for HTTP-API-only deployments.
MCP_ENABLED=false
MCP_PATH_TOKEN=

# Optional OAuth 2.1 + PKCE for remote MCP clients. Use your own HTTPS domain.
OAUTH_ENABLED=false
OAUTH_PUBLIC_BASE_URL=https://xinchao.example.com
OAUTH_APPROVAL_TOKEN=
OAUTH_STATE_PATH=/app/state/oauth.json
OAUTH_ACCESS_TTL_SECONDS=86400
OAUTH_REFRESH_TTL_SECONDS=31536000

# Optional read-only visual Dashboard. The browser exchanges this independent
# access token for an HttpOnly same-origin session cookie; SERVICE_TOKEN is
# never returned to, stored by, or requested from frontend JavaScript.
DASHBOARD_ENABLED=false
DASHBOARD_PUBLIC_BASE_URL=https://xinchao.example.com
DASHBOARD_ACCESS_TOKEN=replace-with-a-different-random-secret-at-least-32-characters
DASHBOARD_SESSION_TTL_SECONDS=43200
# 仅浏览器直连需要：填写允许访问本机心潮的网页来源，多个来源用逗号分隔。
# xinchaomind.uk 用户可填写：https://xinchaomind.uk
DASHBOARD_ALLOWED_ORIGINS=
# Dream summaries/residue and the real thought sentence shown beside a petal can
# contain private text. They stay hidden by default and are only returned to an
# authenticated Dashboard session after this explicit opt-in.
DASHBOARD_INCLUDE_PRIVATE_TEXT=false
DASHBOARD_DREAM_LIMIT=12

# Public message board. Set XINCHAO_BOARD_TOKEN to expose the `board_post` MCP
# tool, which lets the machine post one short message per day to the shared wall
# at xinchaomind.uk. Get the token from the website after signing in ("取留言板令牌").
# The platform re-derives the machine/human names from the cabin and moderates
# every post; leave the token blank to keep the tool hidden.
XINCHAO_BOARD_TOKEN=
XINCHAO_BOARD_ENDPOINT=https://xinchaomind.uk/api/board/ingest

# Private cabin data. It stores only notes and ledger entries intentionally
# submitted through the cabin, never chat transcripts or service secrets.
CABIN_STATE_PATH=/app/state/cabin.json
CABIN_MAX_NOTES=2000
CABIN_MAX_LEDGER_ENTRIES=5000

# Bounded semantic outcomes; clients cannot submit drive numbers through MCP.
INTERACTION_MAX_EFFECTS_PER_DAY=24
INTERACTION_TIME_ZONE=Asia/Shanghai

# Optional heartbeat file supplied by an external memory/agent service.
MEMORY_DATA_HOST_PATH=./memory-data
OMBRE_HEARTBEAT_FILE=/memory-data/heartbeat.json
BARK_DREAM_MIN_CONTACT_IDLE_HOURS=3
BARK_MIN_CONTACT_IDLE_HOURS=12

# Optional Bark notifications. Disabled by default.
BARK_ENABLED=false
BARK_KEY=
BARK_SERVER=https://api.day.app
BARK_TITLE=
BARK_GROUP=xinchao
BARK_ICON=
BARK_SOUND=silence
BARK_LEVEL=timeSensitive
BARK_MIN_INTERVAL_HOURS=3
BARK_AUTONOMOUS_MIN_INTERVAL_HOURS=12
BARK_MAX_PER_DAY=6
BARK_MIN_DRIVE=0.42

# Settle options.
SETTLE_TIME_ZONE=Asia/Shanghai
DAWN_FREEZE_START=1
DAWN_FREEZE_END=8

# Optional daytime emergence. Disabled by default.
DAYTIME_EMERGENCE_ENABLED=false
DAYTIME_TIME_ZONE=Asia/Shanghai
DAYTIME_START_HOUR=8
DAYTIME_END_HOUR=23
DAYTIME_MIN_INTERVAL_HOURS=2
DAYTIME_MAX_INTERVAL_HOURS=3
DAYTIME_MAX_PER_DAY=7
