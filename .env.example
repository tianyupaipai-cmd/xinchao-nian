# 心潮·念 联合部署配置模板
#   cp .env.example .env  然后填下面标「必填」的项，其余可留空、之后在 Dashboard 里改。

# ── Ombre Brain（记忆库）──────────────────────────────
OMBRE_COMPRESS_API_KEY=            # 必填：压缩/脱水用的 LLM key
OMBRE_DASHBOARD_PASSWORD=          # 必填：OB Dashboard 登录密码
OMBRE_MCP_SERVICE_TOKEN=           # 必填：心潮↔OB 内部鉴权令牌（自己生成一串随机值，两边共用）
OMBRE_COMPRESS_BASE_URL=
OMBRE_COMPRESS_MODEL=
OMBRE_EMBED_API_KEY=               # 向量化 key，可留空，之后 Dashboard 里填
OMBRE_EMBED_BASE_URL=
OMBRE_EMBED_MODEL=
OMBRE_HOST_PORT=18001              # OB 本机端口（反代用）
OMBRE_HOST_VAULT_DIR=              # 想固定数据目录填绝对路径；留空则用 ./buckets

# ── 心潮（动态心智）──────────────────────────────────
# OB 读写开关：联合部署下默认都开，让共振/回流/统一入口生效
OMBRE_READ_ENABLED=true
OMBRE_WRITE_ENABLED=true
# 只供心潮服务端内部调用 OB。不要把它填进 xinchaomind.uk，
# 也不要把它当成 Claude / ChatGPT 的心潮 MCP 连接器地址。
OMBRE_MCP_URL=http://ombre-brain:8000/mcp   # 内部网络，容器名解析
OMBRE_MCP_TOKEN=                  # 填成和 OMBRE_MCP_SERVICE_TOKEN 相同的值
SHADOW_MODE=false
# 心潮↔OB sidecar（OB 反向读心潮状态）
DYNAMIC_MIND_TOKEN=               # 必填：自己生成随机值；同时作为心潮 SERVICE_TOKEN

# ── 心潮 MCP/OAuth（Claude / ChatGPT / IDE 连接器）──────
# 公网域名必须反代到心潮 18110，不是 OB 18001，也不是 xinchaomind.uk。
# 真正填入 AI 连接器的 URL = OAUTH_PUBLIC_BASE_URL + /mcp。不使用时保持 false。
MCP_ENABLED=false
OAUTH_ENABLED=false
OAUTH_PUBLIC_BASE_URL=         # 例：https://xinchao.example.com（不要加 /mcp）
OAUTH_APPROVAL_TOKEN=          # 授权页口令，至少 16 字符，不得复用其他 token

# ── 心潮念公开可视化连接 ─────────────────────────────
# 生成方式：openssl rand -hex 32。必须与上面的令牌、OB 密码互不相同。
DASHBOARD_ENABLED=true
DASHBOARD_ACCESS_TOKEN=           # 必填：网页连接时填写的 Dashboard 独立口令（至少 32 字符）
# 这是你自己心潮实例的基础地址，不是 xinchaomind.uk，也不要加 /mcp。
DASHBOARD_PUBLIC_BASE_URL=http://localhost:18110
# 仅“浏览器与心潮在同一台设备”直连时需要；公网 HTTPS 中继模式不依赖 CORS。
DASHBOARD_ALLOWED_ORIGINS=https://xinchaomind.uk
DASHBOARD_SESSION_TTL_SECONDS=43200
DASHBOARD_INCLUDE_PRIVATE_TEXT=false

# ── 融合功能开关（都默认开，可单独关）────────────────
OUTPUT_REFLUX_ENABLED=true        # 输出回流
MEMORY_RESONANCE_ENABLED=true     # 记忆共振
ANTICIPATION_ENABLED=true         # 作息预期
LONGING_ENABLED=true              # 挂念
DREAM_ENABLED=true                # 梦境（安全化后新梦出生即 dont_surface）
DREAM_MIN_INTERVAL_HOURS=24
DREAM_MAX_PER_DAY=4

# ── 公共留言板（board_post 工具）─────────────────────
# 填了 TOKEN 才会出现 board_post 工具，让机往 xinchaomind 的公共留言墙发帖。
# TOKEN 在网页端登录后「取留言板令牌」处获取；每机每天一条、发前平台会审核。
XINCHAO_BOARD_TOKEN=              # 留空则不启用留言板工具
XINCHAO_BOARD_ENDPOINT=https://xinchaomind.uk/api/board/ingest

# 其余心潮参数（bark/settle/时区等）见 xinchao/.env.example
